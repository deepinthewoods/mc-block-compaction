{
	"schemaVersion": 1,
	"id": "blockcompaction",
	"version": "${version}",
	"name": "Block Compaction",
	"description": "Automatically transform blocks in your inventory using stonecutter recipes. Hover over blocks to see transformations, scroll to select, and pick up to transform!",
	"authors": [
		"deepinthewoods"
	],
	"contact": {
		"sources": "https://github.com/deepinthewoods/mc-block-compaction"
	},
	"license": "CC0-1.0",
	"icon": "assets/blockcompaction/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.blockcompaction.BlockCompactionMod"
		],
		"client": [
			"com.blockcompaction.BlockCompactionClient"
		]
	},
	"mixins": [
		"blockcompaction.mixins.json",
		{
			"config": "blockcompaction.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}